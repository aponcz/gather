{
  "containerDefinitions": [
      {
          "name": "gather",
          "image": "<%= ENV['AWS_ACCOUNT_ID'] %>.dkr.ecr.us-east-1.amazonaws.com/<%= ENV['AWS_ENV'] %>/gather-backend:<%= ENV['TAG'] %>",
          "cpu": 0,
          "memory": 2048,
          "memoryReservation": 1536,
          "portMappings": [
              {
                  "containerPort": 5000,
                  "hostPort": 0,
                  "protocol": "tcp"
              }
          ],
          "essential": true,
          "environment": [
              {
                  "name": "EMAIL_DOMAIN",
                  "value": "goprotext.com"
              },
              {
                  "name": "FOG_REGION",
                  "value": "us-east-1"
              },
              {
                  "name": "LANG",
                  "value": "en_US.UTF-8"
              },
              {
                  "name": "RACK_ENV",
                  "value": "production"
              },
              {
                  "name": "SENDGRID_USERNAME",
                  "value": "apikey"
              },
              {
                  "name": "CLIENT_APP_URL",
                  "value": "https://app.gather.stage.goprotext.com"
              },
              {
                  "name": "GOPROTEXT_OAUTH_AUTHORIZE_URL",
                  "value": "https://id.stage.goprotext.com/oauth/authorize"
              },
              {
                  "name": "GOPROTEXT_OAUTH_TOKEN_URL",
                  "value": "https://id.stage.goprotext.com/oauth/token"
              },
              {
                  "name": "GOPROTEXT_OAUTH_USERINFO_URL",
                  "value": "https://id.stage.goprotext.com/api/v2/me"
              },
              {
                  "name": "GOPROTEXT_LOANS_URL",
                  "value": "https://id.stage.goprotext.com/api/v2/loans"
              },
              {
                  "name": "GOPROTEXT_OAUTH_TOKEN_GRANT_TYPE",
                  "value": "refresh_token"
              },
              {
                  "name": "GOPROTEXT_OAUTH_REDIRECT_URI",
                  "value": "https://backend.gather.stage.goprotext.com/api/v1/auth/oauth/goprotext/callback"
              },
              {
                  "name": "GOPROTEXT_OAUTH_SCOPE",
                  "value": "public loan_read loan_write loan_closing_requirements"
              },
              {
                  "name": "FRONTEND_OAUTH_CALLBACK_URL",
                  "value": "https://app.gather.stage.goprotext.com/login/oauth-callback"
              },
              {
                  "name": "S3_BUCKET",
                  "value": "stage-gather-uploads"
              },
              {
                  "name": "S3_FORCE_PATH_STYLE",
                  "value": "true"
              }
          ],
          "mountPoints": [],
          "volumesFrom": [],
          "secrets": [
              {
                  "name": "ASSET_BUCKET",
                  "valueFrom": "/<%= ENV['AWS_ENV'] %>/gather/ASSET_BUCKET"
              },
              {
                  "name": "ASSET_HOST",
                  "valueFrom": "/<%= ENV['AWS_ENV'] %>/gather/ASSET_HOST"
              },
              {
                  "name": "ATTR_ENCRYPTION_KEY",
                  "valueFrom": "/<%= ENV['AWS_ENV'] %>/gather/ATTR_ENCRYPTION_KEY"
              },
              {
                  "name": "DATABASE_URL",
                  "valueFrom": "/<%= ENV['AWS_ENV'] %>/gather/AURORA_DATABASE_URL"
              },
              {
                  "name": "DOMAIN",
                  "valueFrom": "/<%= ENV['AWS_ENV'] %>/gather/DOMAIN"
              },
              {
                  "name": "ENCRYPTION_DETERMINISTIC_KEY",
                  "valueFrom": "/<%= ENV['AWS_ENV'] %>/gather/ENCRYPTION_DETERMINISTIC_KEY"
              },
              {
                  "name": "ENCRYPTION_KEY_DERIVATION_SALT",
                  "valueFrom": "/<%= ENV['AWS_ENV'] %>/gather/ENCRYPTION_KEY_DERIVATION_SALT"
              },
              {
                  "name": "ENCRYPTION_PRIMARY_KEY",
                  "valueFrom": "/<%= ENV['AWS_ENV'] %>/gather/ENCRYPTION_PRIMARY_KEY"
              },
              {
                  "name": "GOPROTEXT_OAUTH_CLIENT_ID",
                  "valueFrom": "/<%= ENV['AWS_ENV'] %>/gather/GOPROTEXT_OAUTH_CLIENT_ID"
              },
              {
                  "name": "GOPROTEXT_OAUTH_CLIENT_SECRET",
                  "valueFrom": "/<%= ENV['AWS_ENV'] %>/gather/GOPROTEXT_OAUTH_CLIENT_SECRET"
              },
              {
                  "name": "JWT_SECRET_TOKEN",
                  "valueFrom": "/<%= ENV['AWS_ENV'] %>/gather/JWT_SECRET_TOKEN"
              },
              {
                  "name": "SECRET_KEY_BASE",
                  "valueFrom": "/<%= ENV['AWS_ENV'] %>/gather/SECRET_KEY_BASE"
              },
              {
                  "name": "SENDGRID_PASSWORD",
                  "valueFrom": "/<%= ENV['AWS_ENV'] %>/gather/SENDGRID_PASSWORD"
              },
              {
                  "name": "SENTRY_CURRENT_ENV",
                  "valueFrom": "/<%= ENV['AWS_ENV'] %>/gather/SENTRY_CURRENT_ENV"
              },
              {
                  "name": "SENTRY_DSN",
                  "valueFrom": "/<%= ENV['AWS_ENV'] %>/gather/SENTRY_DSN"
              },
              {
                  "name": "SENTRY_DSN_PUBLIC",
                  "valueFrom": "/<%= ENV['AWS_ENV'] %>/gather/SENTRY_DSN_PUBLIC"
              }
          ],
          "dockerLabels": {},
          "ulimits": [
              {
                  "name": "core",
                  "softLimit": 0,
                  "hardLimit": 0
              }
          ],
          "logConfiguration": {
              "logDriver": "awslogs",
              "options": {
                  "awslogs-create-group": "true",
                  "awslogs-group": "/aws/ecs/<%= ENV['AWS_ENV'] %>-gather",
                  "awslogs-region": "us-east-1"
              }
          },
          "healthCheck": {
              "command": [
                  "CMD-SHELL",
                  "echo 'ok'"
              ],
              "interval": 10,
              "timeout": 5,
              "retries": 2
          },
          "systemControls": []
      }
  ],
  "family": "<%= ENV['AWS_ENV'] %>-gather-web",
  "taskRoleArn": "arn:aws:iam::<%= ENV['AWS_ACCOUNT_ID'] %>:role/<%= ENV['AWS_ENV'] %>-gather-web-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::<%= ENV['AWS_ACCOUNT_ID'] %>:role/<%= ENV['AWS_ENV'] %>-gather-web-ecs-task-execution-role",
  "networkMode": "bridge",
  "revision": 651,
  "volumes": [],
  "status": "ACTIVE",
  "requiresAttributes": [
      {
          "name": "com.amazonaws.ecs.capability.logging-driver.awslogs"
      },
      {
          "name": "com.amazonaws.ecs.capability.docker-remote-api.1.24"
      },
      {
          "name": "ecs.capability.execution-role-awslogs"
      },
      {
          "name": "com.amazonaws.ecs.capability.ecr-auth"
      },
      {
          "name": "com.amazonaws.ecs.capability.docker-remote-api.1.19"
      },
      {
          "name": "com.amazonaws.ecs.capability.docker-remote-api.1.21"
      },
      {
          "name": "com.amazonaws.ecs.capability.task-iam-role"
      },
      {
          "name": "ecs.capability.container-health-check"
      },
      {
          "name": "ecs.capability.execution-role-ecr-pull"
      },
      {
          "name": "ecs.capability.secrets.ssm.environment-variables"
      },
      {
          "name": "com.amazonaws.ecs.capability.docker-remote-api.1.18"
      },
      {
          "name": "com.amazonaws.ecs.capability.docker-remote-api.1.29"
      }
  ],
  "placementConstraints": [],
  "compatibilities": [
      "EXTERNAL",
      "EC2"
  ],
  "requiresCompatibilities": [
      "EC2"
  ]
}