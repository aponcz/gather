<div style="height:6px;background:#7947eb;font-size:0;line-height:0;">&nbsp;</div>
<div style="padding:48px 48px 42px;">
  <div style="display:inline-block;padding:7px 11px;border:1px solid #e2d6ff;border-radius:999px;background:#f0eaff;color:#7042df;font-size:11px;font-weight:800;letter-spacing:1px;text-transform:uppercase;">Document request</div>
  <h1 style="margin:22px 0 16px;color:#17132d;font-size:34px;line-height:1.12;letter-spacing:-1.3px;">Everything you need,<br><span style="color:#7544ed;">all in one place.</span></h1>
  <p style="margin:0 0 12px;color:#5f596d;font-size:16px;line-height:1.7;">Hi<%= " #{@recipient_name}" if @recipient_name.present? %>,</p>
  <p style="margin:0;color:#5f596d;font-size:16px;line-height:1.7;"><strong style="color:#28223f;"><%= @company.name %></strong> has requested documents for <strong style="color:#28223f;"><%= @loan.title %></strong>.</p>
  <% if @loan.message.present? %>
    <div style="margin:24px 0 0;padding:17px 19px;border-left:4px solid #8b5aef;border-radius:4px 12px 12px 4px;background:#f7f4fb;color:#5f596d;font-size:14px;line-height:1.65;"><%= @loan.message %></div>
  <% end %>
  <% if @loan.due_at.present? || @loan.loan_type.present? || @loan.loan_amount_in_cents.present? %>
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top:24px;border:1px solid #eee9f4;border-radius:14px;background:#fcfbfe;">
      <tr>
        <% if @loan.due_at.present? %><td style="padding:15px 17px;"><span style="display:block;color:#918b9e;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;">Due date</span><strong style="display:block;margin-top:5px;color:#302a40;font-size:13px;"><%= @loan.due_at.strftime('%B %-d, %Y') %></strong></td><% end %>
        <% if @loan.loan_type.present? %><td style="padding:15px 17px;"><span style="display:block;color:#918b9e;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;">Loan type</span><strong style="display:block;margin-top:5px;color:#302a40;font-size:13px;"><%= @loan.loan_type %></strong></td><% end %>
        <% if @loan.loan_amount_in_cents.present? %><td style="padding:15px 17px;"><span style="display:block;color:#918b9e;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;">Amount</span><strong style="display:block;margin-top:5px;color:#302a40;font-size:13px;"><%= number_to_currency(@loan.loan_amount_in_cents / 100.0) %></strong></td><% end %>
      </tr>
    </table>
  <% end %>
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin-top:30px;"><tr><td style="border-radius:14px;background:#7544ed;"><a clicktracking="off" href="<%= @client_url %>" style="display:inline-block;padding:15px 22px;color:#ffffff;font-size:15px;font-weight:800;text-decoration:none;">View document request&nbsp;&nbsp;→</a></td></tr></table>
  <p style="margin:22px 0 0;color:#918b9e;font-size:12px;line-height:1.6;">This personal link securely signs you in and expires in 7 days. Please don’t forward it.</p>
</div>
